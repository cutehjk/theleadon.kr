---
import { Image } from 'astro:assets';
import { CATEGORIES, type Post } from '../lib/news';

interface Props { post: Post; eager?: boolean }
const { post, eager = false } = Astro.props;
const { cover, coverAlt, category } = post.data;
const cat = CATEGORIES[category];
---
<div class="news-thumb">
  {cover ? (
    <Image src={cover} alt={coverAlt!} widths={[400, 800]} sizes="(max-width:640px) 100vw, (max-width:960px) 50vw, 380px" loading={eager ? 'eager' : 'lazy'} />
  ) : (
    <div class="news-ph" role="img" aria-label={`${cat.label} 기본 이미지`}>
      <img src="/mark.png" alt="" width="34" height="26">
      <span class="news-ph-cat">{cat.en}</span>
      <span class="news-ph-word">THELEAD<b>ON</b></span>
    </div>
  )}
</div>
