---
import NewsThumb from './NewsThumb.astro';
import { CATEGORIES, formatDate, isNew, postUrl, type Post } from '../lib/news';

interface Props { post: Post; headingLevel?: 'h2' | 'h3' }
const { post, headingLevel = 'h3' } = Astro.props;
const { title, category, date } = post.data;
const H = headingLevel;
---
<article class="news-card">
  <a href={postUrl(post)}>
    <NewsThumb post={post} />
    <div class="news-body">
      <div class="news-meta">
        <span class="news-cat">{CATEGORIES[category].label}</span>
        {isNew(date) && <span class="news-new">NEW</span>}
      </div>
      <H>{title}</H>
      <time class="news-date" datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
    </div>
  </a>
</article>
