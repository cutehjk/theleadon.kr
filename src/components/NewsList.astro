---
import type { Page } from 'astro';
import NewsCard from './NewsCard.astro';
import { CATEGORIES, formatDate, postUrl, type CategoryKey, type Post } from '../lib/news';

interface Props {
  page: Page<Post>;
  pinned: Post[];
  category?: CategoryKey;
}
const { page, pinned, category } = Astro.props;
const base = category ? `/news/category/${category}/` : '/news/';
const pageHref = (n: number) => (n === 1 ? base : `${base}${n}/`);
const tabs = [
  { href: '/news/', label: '전체', key: undefined },
  ...Object.entries(CATEGORIES).map(([key, c]) => ({ href: `/news/category/${key}/`, label: c.label, key })),
];
const showPinned = page.currentPage === 1 && pinned.length > 0;
---
<nav class="news-tabs" aria-label="분류">
  {tabs.map((t) => <a href={t.href} aria-current={t.key === category ? 'page' : undefined}>{t.label}</a>)}
</nav>

{showPinned && (
  <ul class="pinned" aria-label="고정 공지">
    {pinned.map((p) => (
      <li><a href={postUrl(p)}>
        <span class="pin-badge">고정</span>
        <span class="news-cat">{CATEGORIES[p.data.category].label}</span>
        <span class="pinned-title">{p.data.title}</span>
        <time class="news-date" datetime={p.data.date.toISOString().slice(0, 10)}>{formatDate(p.data.date)}</time>
      </a></li>
    ))}
  </ul>
)}

{page.data.length > 0 ? (
  <div class="news-grid">{page.data.map((p) => <NewsCard post={p} />)}</div>
) : (
  !showPinned && <p class="news-empty">등록된 글이 없습니다.</p>
)}

{page.lastPage > 1 && (
  <nav class="pager" aria-label="페이지">
    {page.currentPage > 1 ? <a href={pageHref(page.currentPage - 1)} aria-label="이전 페이지">‹</a> : <span aria-hidden="true">‹</span>}
    {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((n) => (
      <a href={pageHref(n)} aria-current={n === page.currentPage ? 'page' : undefined} aria-label={`${n}페이지`}>{n}</a>
    ))}
    {page.currentPage < page.lastPage ? <a href={pageHref(page.currentPage + 1)} aria-label="다음 페이지">›</a> : <span aria-hidden="true">›</span>}
  </nav>
)}
