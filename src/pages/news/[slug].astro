---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { CATEGORIES, formatDate, getPosts, postUrl, type Post } from '../../lib/news';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  // 목록은 최신순: 이전 글 = 더 오래된 글, 다음 글 = 더 최근 글
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: posts[i + 1] as Post | undefined, next: posts[i - 1] as Post | undefined },
  }));
}) satisfies GetStaticPaths;

const { post, prev, next } = Astro.props;
const { title, category, date, cover, coverAlt, attachments } = post.data;
const { Content } = await render(post);
const cat = CATEGORIES[category];
const iso = date.toISOString().slice(0, 10);
const og = cover ? (await getImage({ src: cover, width: 1200, height: 675, fit: 'cover', format: 'jpg' })).src : undefined;
const excerpt = (post.body ?? '').replace(/[#>*_`\[\]()!-]/g, '').replace(/\s+/g, ' ').trim().slice(0, 110);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  datePublished: iso,
  ...(og ? { image: new URL(og, Astro.site).href } : {}),
  publisher: { '@type': 'Organization', name: '주식회사 더리드온' },
};
---
<Base title={title} description={excerpt || `${cat.label} - 더리드온 소식`} section="news" ogImage={og} ogType="article">
<script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
<PageHead eyebrow="News" title="소식" crumbs={[{ href: '/news/', label: '소식' }, { href: `/news/category/${category}/`, label: cat.label }]} />
<section class="section"><div class="wrap">
<article class="article">
  <div class="article-meta"><span class="news-cat">{cat.label}</span><time class="news-date" datetime={iso}>{formatDate(date)}</time></div>
  <h1>{title}</h1>
  {cover && (
    <figure class="article-cover">
      <Image src={cover} alt={coverAlt!} widths={[720, 1440]} sizes="(max-width:760px) 100vw, 720px" loading="eager" />
      <figcaption>{coverAlt}</figcaption>
    </figure>
  )}
  <div class="prose"><Content /></div>

  {attachments.length > 0 && (
    <div class="files"><h2>첨부파일</h2><ul>
      {attachments.map((f) => <li><a href={f.href} download>📄 {f.name} {f.size && <small>({f.size})</small>}</a></li>)}
    </ul></div>
  )}

  {(prev || next) && (
    <nav class="prevnext" aria-label="이전·다음 글">
      {prev && <a href={postUrl(prev)}><span class="label">이전 글</span><b>{prev.data.title}</b><span class="news-date">{formatDate(prev.data.date)}</span></a>}
      {next && <a href={postUrl(next)}><span class="label">다음 글</span><b>{next.data.title}</b><span class="news-date">{formatDate(next.data.date)}</span></a>}
    </nav>
  )}
  <div class="article-actions">
    <a class="btn btn-navy" href="/news/">목록</a>
    <button class="btn btn-line" type="button" data-copy-link>🔗 링크 복사</button>
  </div>
</article>
</div></section>
<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  btn?.addEventListener('click', async () => {
    const label = btn.textContent;
    try { await navigator.clipboard.writeText(location.href); btn.textContent = '✓ 복사되었습니다'; }
    catch { btn.textContent = '복사에 실패했습니다'; }
    setTimeout(() => { btn.textContent = label; }, 1600);
  });
</script>
</Base>
