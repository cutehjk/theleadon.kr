---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import NewsList from '../../components/NewsList.astro';
import { getPosts, splitPinned, PER_PAGE } from '../../lib/news';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  if (posts.length === 0) return []; // 글이 없으면 소식 페이지를 만들지 않음
  const { pinned, rest } = splitPinned(posts);
  return paginate(rest, { pageSize: PER_PAGE, props: { pinned } });
}) satisfies GetStaticPaths;

const { page, pinned } = Astro.props;
const suffix = page.currentPage > 1 ? ` (${page.currentPage}페이지)` : '';
---
<Base title={`소식${suffix}`} description="더리드온의 공지사항, 보도자료, 사업 소식을 전합니다." section="news">
<PageHead eyebrow="News" title="소식" lead="더리드온의 공지와 사업 소식을 전합니다." crumbs={[{ label: '소식' }]} />
<section class="section"><div class="wrap">
  <NewsList page={page} pinned={pinned} />
</div></section>
</Base>
